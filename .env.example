# ============================================================================
# thqbot 环境变量模板
# 复制为 .env 后按需修改。本模板不含任何真实密钥。
# ============================================================================

# ---- 代理（可选：容器/进程访问外网或模型端点时需要） ----
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=postgres,redis,kafka,minio,localhost,127.0.0.1

# ---- pip 源 ----
PIP_INDEX_URL=https://pypi.org/simple

# ---- 宿主侧端口映射 ----
POSTGRES_PORT=5432
KAFKA_PORT=29092
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
GATEWAY_PORT=8090
ITHQBOT_HEALTH_PORT=9002

# ---- PostgreSQL（唯一事实来源） ----
POSTGRES_USER=thqbot
POSTGRES_PASSWORD=thqbot_dev_pw
POSTGRES_DB=thqbot

# ---- Kafka（入站 / 出站主题） ----
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_INBOUND_TOPIC=icatmsg_inbound
KAFKA_OUTBOUND_TOPIC=icatmsg_outbound
KAFKA_INBOUND_PARTITIONS=3
KAFKA_OUTBOUND_PARTITIONS=3
KAFKA_OUTBOUND_GROUP=thqbot-gateway

# ---- MinIO / 对象存储（附件与技能产物） ----
# 宿主机进程用 127.0.0.1:9000；容器内用 minio:9000（compose 会自动改写）。
# bucket 会在网关启动时自动确保存在，也可用 scripts/init_minio.py 预先创建。
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=ithqbot-storage
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_CONTAINER_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
# 可选：显式 region（MinIO 会忽略；缺省 us-east-1）
MINIO_REGION=

# ---- Redis（本仓库不托管，请自备实例） ----
# docker run -d -p 6379:6379 --name redis redis:7-alpine
# 仅用于：消费幂等去重 / SSE Pub-Sub / 进度状态缓存 / 并发锁。
REDIS_PORT=6379

# ---- 网关（单应用后端） ----
APP_SESSION_SECRET=dev-session-secret-change-me
# 逗号或 JSON 形式的初始账号；留空则使用默认演示账号 admin/admin123456
APP_AUTH_USERS=
APP_AGENT_TENANT_ID=thqbot
APP_AGENT_BOT_ID=bot_A
# 仅用于前端"权限提示"展示（工作区受限 / 完全访问），不影响 worker 行为
APP_AGENT_WORKSPACE_RESTRICTED=true
# 单附件大小上限（字节），默认 20MB
APP_MAX_UPLOAD_BYTES=20971520

# ---- LLM provider（任何 OpenAI 兼容端点） ----
# base_url 形如 https://api.deepseek.com 或 https://api.siliconflow.cn/v1
APP_LLM_BASE_URL=
APP_LLM_API_KEY=
APP_LLM_MODEL=
APP_LLM_TIMEOUT_SECONDS=120
# 可选：逗号分隔的模型清单，用于前端模型下拉；留空则只有 APP_LLM_MODEL
APP_LLM_MODELS=
