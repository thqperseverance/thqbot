{
  "name": "schedule.manage",
  "description": "Create, list, and remove reminders or recurring tasks with interval, cron expression, one-time schedule, and timezone support.",
  "version": "1.0.0",
  "namespace": "schedule",
  "category": "atomic",
  "tags": [
    "schedule",
    "reminder",
    "cron"
  ],
  "deprecated": false,
  "input_schema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "description": "Action to perform: add, list, or remove."
      },
      "message": {
        "type": "string",
        "description": "Reminder text or task description."
      },
      "every_seconds": {
        "type": "integer",
        "description": "Interval in seconds for repeated execution."
      },
      "cron_expr": {
        "type": "string",
        "description": "Cron expression used for recurring schedules."
      },
      "at": {
        "type": "string",
        "description": "ISO datetime for one-time execution."
      },
      "tz": {
        "type": "string",
        "description": "IANA timezone used with cron_expr."
      },
      "job_id": {
        "type": "string",
        "description": "Job ID required when action=remove."
      }
    },
    "required": [
      "action"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string"
      },
      "message": {
        "type": "string"
      },
      "job_id": {
        "type": "string"
      },
      "jobs": {
        "type": "array",
        "items": {
          "type": "object"
        }
      }
    }
  },
  "semantic": {
    "produces": [
      {
        "name": "scheduled_job",
        "schema_ref": "#/output_schema",
        "description": "Normalized output semantic `scheduled_job`."
      },
      {
        "name": "job_list",
        "schema_ref": "#/output_schema",
        "description": "Normalized output semantic `job_list`."
      }
    ],
    "consumes": [
      {
        "name": "schedule_request",
        "source": "input",
        "schema_ref": "#/input_schema",
        "description": "Normalized input semantic `schedule_request`."
      },
      {
        "name": "job_reference",
        "source": "input",
        "schema_ref": "#/input_schema",
        "description": "Normalized input semantic `job_reference`."
      }
    ]
  },
  "routing": {
    "type": "internal",
    "service": "cron",
    "timeout_ms": 3000
  },
  "effects": {
    "type": "write",
    "resources": [
      "scheduler_store"
    ]
  },
  "idempotent": false,
  "retryable": false,
  "sla": {
    "latency_ms": 1000,
    "availability": "99.9%"
  },
  "cost": {
    "level": "low"
  },
  "quality": {
    "score": 0.95,
    "source": "manual"
  }
}
